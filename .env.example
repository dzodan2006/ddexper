# Supabase configuration
# Get these from your Supabase Project Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# RaiAccept Payment Gateway configuration
RAIACCEPT_CLIENT_ID=your_raiaccept_client_id
RAIACCEPT_SANDBOX_USERNAME=your_raiaccept_sandbox_username
RAIACCEPT_SANDBOX_PASSWORD=your_raiaccept_sandbox_password
RAIACCEPT_PRODUCTION_USERNAME=your_raiaccept_production_username
RAIACCEPT_PRODUCTION_PASSWORD=your_raiaccept_production_password
RAIACCEPT_MODE=sandbox

